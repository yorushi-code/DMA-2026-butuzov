<?xml version="1.0" encoding="utf-8"?>
<!-- P18: Android 12+ rules (android:dataExtractionRules), separately for cloud
     backup and for device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="database" path="wallet.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
