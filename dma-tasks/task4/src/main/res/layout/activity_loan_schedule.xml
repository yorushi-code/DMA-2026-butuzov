        android:padding="16dp" >

        <TextView style="@style/Task4.Mono" android:text="@string/p26_columns" android:textStyle="bold"/>
        <TextView android:id="@+id/tvRows" style="@style/Task4.Mono" android:text="" />
    </LinearLayout>
</ScrollView>
