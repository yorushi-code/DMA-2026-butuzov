<?xml version="1.0" encoding="utf-8"?>
<!-- T1.1: three round digit buttons share the row equally (width 0dp + weight 1);
     SquareButton makes each one as tall as it is wide, the 50% corners make it round. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/gap">

    <TextView
        style="@style/T5.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/gap_large"
        android:text="@string/t1_1_prompt" />

    <LinearLayout
        android:id="@+id/pin_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large"
        android:orientation="horizontal">

        <dev.yorushi.dma.task5.widget.SquareButton
            android:id="@+id/pin_1"
            style="@style/T5.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/gap_small"
            android:layout_weight="1"
            android:text="@string/digit_1"
            android:textSize="28sp"
            app:shapeAppearance="@style/T5.Shape.Circle" />

        <dev.yorushi.dma.task5.widget.SquareButton
            android:id="@+id/pin_2"
            style="@style/T5.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/gap_small"
            android:layout_weight="1"
            android:text="@string/digit_2"
            android:textSize="28sp"
            app:shapeAppearance="@style/T5.Shape.Circle" />

        <dev.yorushi.dma.task5.widget.SquareButton
            android:id="@+id/pin_3"
            style="@style/T5.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/gap_small"
            android:layout_weight="1"
            android:text="@string/digit_3"
            android:textSize="28sp"
            app:shapeAppearance="@style/T5.Shape.Circle" />
    </LinearLayout>
</LinearLayout>
