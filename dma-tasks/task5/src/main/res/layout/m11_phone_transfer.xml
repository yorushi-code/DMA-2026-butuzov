<?xml version="1.0" encoding="utf-8"?>
<!-- Item 11: a vertical form. Banks are a single-line chip group in a
     HorizontalScrollView; the quick sums are three equal-weight buttons in a row. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/gap"
        android:paddingBottom="@dimen/gap">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/T5.Field"
            android:layout_marginStart="@dimen/gap"
            android:layout_marginEnd="@dimen/gap"
            android:hint="@string/m11_phone"
            app:prefixText="@string/m11_prefix">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/transfer_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/T5.Section"
            android:layout_marginStart="@dimen/gap"
            android:text="@string/m11_bank" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="@dimen/gap"
            android:paddingEnd="@dimen/gap"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/transfer_banks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/bank_1"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip android:id="@+id/bank_1" style="@style/T5.Chip" android:text="@string/m11_bank_1" />

                <com.google.android.material.chip.Chip android:id="@+id/bank_2" style="@style/T5.Chip" android:text="@string/m11_bank_2" />

                <com.google.android.material.chip.Chip android:id="@+id/bank_3" style="@style/T5.Chip" android:text="@string/m11_bank_3" />

                <com.google.android.material.chip.Chip android:id="@+id/bank_4" style="@style/T5.Chip" android:text="@string/m11_bank_4" />

                <com.google.android.material.chip.Chip android:id="@+id/bank_5" style="@style/T5.Chip" android:text="@string/m11_bank_5" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/T5.Field"
            android:layout_marginStart="@dimen/gap"
            android:layout_marginTop="@dimen/gap_large"
            android:layout_marginEnd="@dimen/gap"
            android:hint="@string/m11_amount">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/transfer_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/transfer_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_small"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button android:id="@+id/quick_500" style="@style/T5.QuickSum" android:text="@string/m11_quick_500" />

            <Button android:id="@+id/quick_1000" style="@style/T5.QuickSum" android:text="@string/m11_quick_1000" />

            <Button android:id="@+id/quick_5000" style="@style/T5.QuickSum" android:text="@string/m11_quick_5000" />
        </LinearLayout>

        <TextView
            style="@style/T5.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/m11_fee" />

        <Button
            android:id="@+id/transfer_send"
            style="@style/T5.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="@dimen/gap"
            android:text="@string/m11_send" />
    </LinearLayout>
</ScrollView>
