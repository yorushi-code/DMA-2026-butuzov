<?xml version="1.0" encoding="utf-8"?>
<!-- T4.1: full width (0dp between the parent's sides); the height follows from
     dimensionRatio 16:9. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/ratio_banner"
        style="@style/T5.Subtitle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_gradient_video"
        android:gravity="center"
        android:padding="@dimen/gap"
        android:text="@string/t4_1_banner"
        android:textColor="@color/on_dark"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        style="@style/T5.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gap"
        android:text="@string/t4_1_note"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ratio_banner" />
</androidx.constraintlayout.widget.ConstraintLayout>
