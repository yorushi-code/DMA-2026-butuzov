<?xml version="1.0" encoding="utf-8"?>
<!-- T6.2: inflated into IconCardView, which is itself a horizontal LinearLayout.
     With merge as the root, the icon and the text are added straight to it; a
     LinearLayout root here would add a useless extra level to the tree. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/card_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/brand_soft"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/brand" />

    <TextView
        android:id="@+id/card_text"
        style="@style/T5.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap"
        android:layout_weight="1" />
</merge>
