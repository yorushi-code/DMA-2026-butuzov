    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout style="@style/T5.SettingRow">

        <ImageView
            android:id="@+id/app_icon_5"
            android:layout_width="36dp"
            android:layout_height="36dp"
