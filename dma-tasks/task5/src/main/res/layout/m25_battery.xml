            android:layout_marginTop="6dp"
            android:progress="14"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/app_name_3"
            app:layout_constraintTop_toBottomOf="@id/app_name_3"
            app:trackCornerRadius="2dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout style="@style/T5.SettingRow">

        <ImageView
            android:id="@+id/app_icon_4"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_rounded"
            android:backgroundTint="@color/photo_1"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/app_name_4"
            style="@style/T5.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/m25_app_4"
            app:layout_constraintEnd_toStartOf="@id/app_pct_4"
            app:layout_constraintStart_toEndOf="@id/app_icon_4"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/app_pct_4"
            style="@style/T5.Label"
            android:layout_width="wrap_content"
