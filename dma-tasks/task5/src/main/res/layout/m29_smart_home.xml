                android:text="@string/m29_room_6" />

            <TextView
                style="@style/T5.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:drawablePadding="2dp"
                android:text="@string/m29_temp_6"
                app:drawableStartCompat="@drawable/ic_thermo"
                app:drawableTint="@color/accent" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="@string/m29_hum_6"
                app:drawableStartCompat="@drawable/ic_drop"
                app:drawableTint="@color/photo_5" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="@string/m29_light_off"
                android:textColor="@color/text_muted"
                app:drawableStartCompat="@drawable/ic_bulb"
