<?xml version="1.0" encoding="utf-8"?>
<!-- Item 29: two equal-weight square tiles per row. Inside a tile a FrameLayout places
     the four readings by gravity: room top-left, temperature centre-left, humidity
     bottom-left, light bottom-right. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            style="@style/T5.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/gap_tiny"
            android:text="@string/m29_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <dev.yorushi.dma.task5.widget.SquareFrameLayout
            android:id="@+id/room_1"
            style="@style/T5.Tile"
            android:padding="@dimen/gap">

            <TextView
                style="@style/T5.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m29_room_1" />

            <TextView
                style="@style/T5.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:drawablePadding="2dp"
                android:text="@string/m29_temp_1"
                app:drawableStartCompat="@drawable/ic_thermo"
                app:drawableTint="@color/accent" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="@string/m29_hum_1"
                app:drawableStartCompat="@drawable/ic_drop"
                app:drawableTint="@color/photo_5" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="@string/m29_light_on"
                android:textColor="@color/warning"
                app:drawableStartCompat="@drawable/ic_bulb"
                app:drawableTint="@color/warning" />
        </dev.yorushi.dma.task5.widget.SquareFrameLayout>

        <dev.yorushi.dma.task5.widget.SquareFrameLayout
            android:id="@+id/room_2"
            style="@style/T5.Tile"
            android:padding="@dimen/gap">

            <TextView
                style="@style/T5.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m29_room_2" />

            <TextView
                style="@style/T5.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:drawablePadding="2dp"
                android:text="@string/m29_temp_2"
                app:drawableStartCompat="@drawable/ic_thermo"
                app:drawableTint="@color/accent" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="@string/m29_hum_2"
                app:drawableStartCompat="@drawable/ic_drop"
                app:drawableTint="@color/photo_5" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:drawablePadding="2dp"
                android:gravity="center_vertical"
                android:text="@string/m29_light_off"
                android:textColor="@color/text_muted"
                app:drawableStartCompat="@drawable/ic_bulb"
                app:drawableTint="@color/text_muted" />
        </dev.yorushi.dma.task5.widget.SquareFrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

