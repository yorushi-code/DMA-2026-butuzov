<?xml version="1.0" encoding="utf-8"?>
<!-- T6.4: layout_* attributes on an include override the included root's own; for them
     to apply, layout_width and layout_height must both be given on the include. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/T5.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/gap"
        android:text="@string/t6_4_note" />

    <include
        android:id="@+id/info_full"
        layout="@layout/part_info_card" />

    <include
        android:id="@+id/info_compact"
        layout="@layout/part_info_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="40dp" />
</LinearLayout>
