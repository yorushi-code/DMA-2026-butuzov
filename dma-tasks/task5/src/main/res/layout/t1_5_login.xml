<?xml version="1.0" encoding="utf-8"?>
<!-- T1.5: two borderless fields in one box, split by a 1dp grey View. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/gap">

    <TextView
        style="@style/T5.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/t1_5_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large"
        android:background="@drawable/bg_field_box"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap"
        android:paddingEnd="@dimen/gap">

        <EditText
            android:id="@+id/login_email"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@null"
            android:hint="@string/hint_email"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress" />

        <View
            android:id="@+id/login_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0" />

        <EditText
            android:id="@+id/login_password"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@null"
            android:hint="@string/hint_password"
            android:importantForAutofill="no"
            android:inputType="textPassword" />
    </LinearLayout>

    <Button
        style="@style/T5.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/sign_in" />
</LinearLayout>
