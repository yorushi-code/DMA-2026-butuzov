<?xml version="1.0" encoding="utf-8"?>
<!-- T1.3: the field takes the remaining width (0dp + weight 1), the icon is a fixed 48dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/gap"
    android:background="@drawable/bg_field_box"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/gap">

    <EditText
        android:id="@+id/search_field"
        android:layout_width="0dp"
        android:layout_height="@dimen/touch"
        android:layout_weight="1"
        android:background="@null"
        android:hint="@string/t1_3_hint"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch"
        android:inputType="text" />

    <ImageButton
        android:id="@+id/search_button"
        style="@style/T5.IconButton"
        android:layout_width="48dp"
        android:contentDescription="@string/cd_search"
        android:src="@drawable/ic_search"
        app:tint="@color/brand" />
</LinearLayout>
