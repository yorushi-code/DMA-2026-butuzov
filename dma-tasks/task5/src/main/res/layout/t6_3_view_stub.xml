<?xml version="1.0" encoding="utf-8"?>
<!-- T6.3: the "no internet" screen is a ViewStub until Behaviors.networkStub inflates it.
     The stub takes the remaining height, so the inflated screen fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_common" />

    <TextView
        style="@style/T5.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/gap"
        android:text="@string/t6_3_text" />

    <Button
        android:id="@+id/simulate_offline"
        style="@style/T5.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginEnd="@dimen/gap"
        android:text="@string/t6_3_simulate" />

    <ViewStub
        android:id="@+id/stub_no_internet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inflatedId="@+id/no_internet"
        android:layout="@layout/stub_no_internet" />
</LinearLayout>
