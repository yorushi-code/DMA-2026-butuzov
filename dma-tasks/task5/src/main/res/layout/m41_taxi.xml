<?xml version="1.0" encoding="utf-8"?>
<!-- Item 41: the map is the bottom layer and fills the screen; the search pill floats
     over it at the top; the tariff card is a bottom sheet (BottomSheetBehavior) that
     peeks from below and can be dragged up. CoordinatorLayout is a FrameLayout with
     behaviours: children stack the same way, and it runs the sheet's drag. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/taxi_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/art_map" />

    <TextView
        android:id="@+id/taxi_search"
        style="@style/T5.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="@dimen/gap"
        android:background="@drawable/bg_pill"
        android:drawablePadding="12dp"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/m41_where"
        app:drawableStartCompat="@drawable/ic_search"
        app:drawableTint="@color/text_secondary" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/taxi_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:elevation="12dp"
        android:paddingStart="@dimen/gap"
        android:paddingEnd="@dimen/gap"
        android:paddingBottom="@dimen/gap"
        app:behavior_hideable="false"
        app:behavior_peekHeight="300dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/taxi_handle"
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_handle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/taxi_route"
            style="@style/T5.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:text="@string/m41_route"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/taxi_handle" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tariff_1"
            style="@style/T5.TariffOption"
            app:layout_constraintEnd_toStartOf="@id/tariff_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/taxi_route">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_car"
                    app:tint="@color/photo_6" />

                <TextView
                    style="@style/T5.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tiny"
                    android:text="@string/m41_economy"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m41_price_1"
                    android:textStyle="bold" />

                <TextView
                    style="@style/T5.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m41_eta_1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tariff_2"
            style="@style/T5.TariffOption" android:checked="true"
            app:layout_constraintEnd_toStartOf="@id/tariff_3"
            app:layout_constraintStart_toEndOf="@id/tariff_1"
            app:layout_constraintTop_toBottomOf="@id/taxi_route">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_car"
                    app:tint="@color/photo_5" />

                <TextView
                    style="@style/T5.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tiny"
                    android:text="@string/m41_comfort"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m41_price_2"
                    android:textStyle="bold" />

                <TextView
                    style="@style/T5.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m41_eta_2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tariff_3"
            style="@style/T5.TariffOption"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tariff_2"
            app:layout_constraintTop_toBottomOf="@id/taxi_route">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_car"
                    app:tint="@color/text_primary" />

                <TextView
                    style="@style/T5.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_tiny"
                    android:text="@string/m41_business"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m41_price_3"
                    android:textStyle="bold" />

                <TextView
                    style="@style/T5.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/m41_eta_3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/taxi_payment"
            style="@style/T5.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/m41_payment"
            app:drawableStartCompat="@drawable/ic_card"
            app:drawableTint="@color/text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tariff_1" />

        <Button
            android:id="@+id/taxi_order"
            style="@style/T5.Button"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/m41_order"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/taxi_payment" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
