<?xml version="1.0" encoding="utf-8"?>
<!-- T6.4: included twice by t6_4_include_override.xml with different layout params. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/gap"
    android:background="@drawable/bg_card_flat"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/gap">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_gift"
        app:tint="@color/accent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            style="@style/T5.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/t6_4_card_title" />

        <TextView
            style="@style/T5.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/t6_4_card_text" />
    </LinearLayout>
</LinearLayout>
