<?xml version="1.0" encoding="utf-8"?>
<!-- T3.3: photo on the left; the name starts at the photo's top, to its right;
     the price sits under the name and is pushed down to the photo's bottom edge. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/gap"
    android:background="@drawable/bg_card"
    android:padding="12dp">

    <ImageView
        android:id="@+id/product_photo"
        style="@style/T5.Photo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_alignParentStart="true"
        android:background="@color/photo_2" />

    <TextView
        android:id="@+id/product_name"
        style="@style/T5.Subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/product_photo"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/product_photo"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/t3_3_name" />

    <TextView
        android:id="@+id/product_price"
        style="@style/T5.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/product_name"
        android:layout_alignBottom="@id/product_photo"
        android:layout_below="@id/product_name"
        android:gravity="bottom"
        android:text="@string/t3_3_price"
        android:textStyle="bold" />
</RelativeLayout>
