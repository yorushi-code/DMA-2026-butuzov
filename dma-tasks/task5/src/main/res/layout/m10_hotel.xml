<?xml version="1.0" encoding="utf-8"?>
<!-- Item 10: a horizontal strip of three mini photos (HorizontalScrollView), then a flat
     ConstraintLayout block with name, address, rating, reviews, price and the button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/gap"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="@dimen/gap">

    <HorizontalScrollView
        android:id="@+id/hotel_photos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView style="@style/T5.HotelPhoto" android:backgroundTint="@color/photo_5" />

            <ImageView style="@style/T5.HotelPhoto" android:backgroundTint="@color/photo_2" />

            <ImageView style="@style/T5.HotelPhoto" android:backgroundTint="@color/photo_1" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/gap"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/gap">

        <TextView
            android:id="@+id/hotel_name"
            style="@style/T5.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/m10_name"
            app:layout_constraintEnd_toStartOf="@id/hotel_rating"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/hotel_rating"
            style="@style/T5.Badge"
            android:backgroundTint="@color/ok"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            android:text="@string/m10_rating"
            app:drawableStartCompat="@drawable/ic_star_small"
            app:layout_constraintBottom_toBottomOf="@id/hotel_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/hotel_name" />

        <TextView
            android:id="@+id/hotel_address"
            style="@style/T5.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/m10_address"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hotel_name" />

        <TextView
            android:id="@+id/hotel_reviews"
            style="@style/T5.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tiny"
            android:text="@string/m10_reviews"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hotel_address" />

        <TextView
            android:id="@+id/hotel_price"
            style="@style/T5.Subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/m10_price"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/hotel_book"
            app:layout_constraintEnd_toStartOf="@id/hotel_book"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/hotel_book" />

        <Button
            android:id="@+id/hotel_book"
            style="@style/T5.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/m10_book"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hotel_reviews" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
