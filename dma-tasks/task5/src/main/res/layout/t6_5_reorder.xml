<?xml version="1.0" encoding="utf-8"?>
<!-- T6.5: header and footer are includes; only the list in between is this screen's own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/toolbar_common" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/T5.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/gap"
                android:text="@string/t6_5_reorder_note" />

            <RelativeLayout style="@style/T5.CartRow">

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_item_1" />

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_price_1" />
            </RelativeLayout>

            <RelativeLayout style="@style/T5.CartRow">

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_item_2" />

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_price_2" />
            </RelativeLayout>

            <RelativeLayout style="@style/T5.CartRow">

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_item_3" />

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_price_3" />
            </RelativeLayout>

            <RelativeLayout style="@style/T5.CartRow">

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_item_4" />

                <TextView
                    style="@style/T5.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="@string/t6_5_price_4" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/part_cart_footer" />
</LinearLayout>
