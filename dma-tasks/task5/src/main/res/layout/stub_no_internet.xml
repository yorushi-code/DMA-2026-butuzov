<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/gap_large">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/error_soft"
        android:importantForAccessibility="no"
        android:padding="24dp"
        android:src="@drawable/ic_wifi_off"
        app:tint="@color/error" />

    <TextView
        style="@style/T5.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/t6_3_error_title" />

    <TextView
        style="@style/T5.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        android:gravity="center"
        android:text="@string/t6_3_error_text" />

    <Button
        android:id="@+id/retry"
        style="@style/T5.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/t6_3_retry" />
</LinearLayout>
