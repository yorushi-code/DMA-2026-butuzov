<?xml version="1.0" encoding="utf-8"?>
<!-- Item 33: everything is a layer of one full-screen FrameLayout: the video, a dark
     gradient at the bottom for legibility, the caption bottom-start and the column of
     actions bottom-end (a vertical LinearLayout of icon-over-count TextViews). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="Overdraw"
    android:background="@color/media_dark">

    <ImageView
        android:id="@+id/reels_video"
        style="@style/T5.Photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_video"
        android:src="@drawable/ic_play" />

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom" />

    <TextView
        style="@style/T5.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gap"
        android:text="@string/m33_header"
        android:textColor="@color/on_dark"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/reels_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="@dimen/gap_large"
        android:orientation="vertical">

        <TextView
            style="@style/T5.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/m33_author"
            android:textColor="@color/on_dark"
            android:textStyle="bold" />

        <TextView
            style="@style/T5.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_tiny"
            android:text="@string/m33_caption"
            android:textColor="@color/on_dark" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/reels_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/gap_small"
        android:layout_marginBottom="@dimen/gap_large"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reels_like"
            style="@style/T5.ReelAction"
            android:contentDescription="@string/cd_like"
            android:text="@string/m33_likes"
            app:drawableTopCompat="@drawable/ic_heart" />

        <TextView
            android:id="@+id/reels_comments"
            style="@style/T5.ReelAction"
            android:contentDescription="@string/cd_comments"
            android:text="@string/m33_comments"
            app:drawableTopCompat="@drawable/ic_comment" />

        <TextView
            android:id="@+id/reels_repost"
            style="@style/T5.ReelAction"
            android:contentDescription="@string/cd_repost"
            android:text="@string/m33_reposts"
            app:drawableTopCompat="@drawable/ic_send" />

        <TextView
            android:id="@+id/reels_sound"
            style="@style/T5.ReelAction"
            android:contentDescription="@string/cd_sound"
            android:text="@string/m33_sound"
            app:drawableTopCompat="@drawable/ic_volume" />

    </LinearLayout>
</FrameLayout>
