<?xml version="1.0" encoding="utf-8"?>
<!-- Item 28: each order is one flat ConstraintLayout card: date and coloured status on
     the first line (baseline-aligned), the item thumbnails in a row, total and the
     repeat button at the bottom. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/gap_small"
        android:paddingBottom="@dimen/gap">

        <androidx.constraintlayout.widget.ConstraintLayout style="@style/T5.OrderCard">

            <TextView
                android:id="@+id/order_date_1"
                style="@style/T5.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m28_date_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/order_status_1"
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/m28_status_1"
                android:textColor="@color/brand"
                app:drawableStartCompat="@drawable/bg_dot"
                app:drawableTint="@color/brand"
                app:layout_constraintBaseline_toBaselineOf="@id/order_date_1"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/order_thumbs_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/order_date_1">

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_1" />

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_2" />

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_3" />

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_5" />

            </LinearLayout>

            <TextView
                android:id="@+id/order_total_1"
                style="@style/T5.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/m28_total_1"
                app:layout_constraintBottom_toBottomOf="@id/order_repeat_1"
                app:layout_constraintEnd_toStartOf="@id/order_repeat_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/order_repeat_1" />

            <Button
                android:id="@+id/order_repeat_1"
                style="@style/T5.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/m28_repeat"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/order_thumbs_1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout style="@style/T5.OrderCard">

            <TextView
                android:id="@+id/order_date_2"
                style="@style/T5.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m28_date_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/order_status_2"
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/m28_status_2"
                android:textColor="@color/ok"
                app:drawableStartCompat="@drawable/bg_dot"
                app:drawableTint="@color/ok"
                app:layout_constraintBaseline_toBaselineOf="@id/order_date_2"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/order_thumbs_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/order_date_2">

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_4" />

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_6" />

            </LinearLayout>

            <TextView
                android:id="@+id/order_total_2"
                style="@style/T5.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/m28_total_2"
                app:layout_constraintBottom_toBottomOf="@id/order_repeat_2"
                app:layout_constraintEnd_toStartOf="@id/order_repeat_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/order_repeat_2" />

            <Button
                android:id="@+id/order_repeat_2"
                style="@style/T5.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/m28_repeat"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/order_thumbs_2" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout style="@style/T5.OrderCard">

            <TextView
                android:id="@+id/order_date_3"
                style="@style/T5.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/m28_date_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/order_status_3"
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="@string/m28_status_3"
                android:textColor="@color/error"
                app:drawableStartCompat="@drawable/bg_dot"
                app:drawableTint="@color/error"
                app:layout_constraintBaseline_toBaselineOf="@id/order_date_3"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/order_thumbs_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/order_date_3">

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_5" />

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_1" />

                <ImageView style="@style/T5.Thumb" android:backgroundTint="@color/photo_2" />

            </LinearLayout>

            <TextView
                android:id="@+id/order_total_3"
                style="@style/T5.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/m28_total_3"
                app:layout_constraintBottom_toBottomOf="@id/order_repeat_3"
                app:layout_constraintEnd_toStartOf="@id/order_repeat_3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/order_repeat_3" />

            <Button
                android:id="@+id/order_repeat_3"
                style="@style/T5.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_small"
                android:text="@string/m28_repeat"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/order_thumbs_3" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
