<?xml version="1.0" encoding="utf-8"?>
<!-- Item 19: the whole block is a packed vertical chain centred on the screen; the six
     square cells sit in a centred horizontal row. Behaviors.smsCode moves the focus to the
     next cell after a digit and back on delete. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/gap">

    <TextView
        android:id="@+id/sms_title"
        style="@style/T5.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/m19_title"
        app:layout_constraintBottom_toTopOf="@id/sms_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/sms_subtitle"
        style="@style/T5.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_small"
        android:gravity="center"
        android:text="@string/m19_subtitle"
        app:layout_constraintBottom_toTopOf="@id/sms_cells"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sms_title" />

    <LinearLayout
        android:id="@+id/sms_cells"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/sms_resend"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sms_subtitle">

        <EditText
            android:id="@+id/sms_digit_1"
            style="@style/T5.OtpDigit" />

        <EditText
            android:id="@+id/sms_digit_2"
            style="@style/T5.OtpDigit" />

        <EditText
            android:id="@+id/sms_digit_3"
            style="@style/T5.OtpDigit" />

        <EditText
            android:id="@+id/sms_digit_4"
            style="@style/T5.OtpDigit" />

        <EditText
            android:id="@+id/sms_digit_5"
            style="@style/T5.OtpDigit" />

        <EditText
            android:id="@+id/sms_digit_6"
            style="@style/T5.OtpDigit" />

    </LinearLayout>

    <TextView
        android:id="@+id/sms_resend"
        style="@style/T5.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large"
        android:text="@string/m19_resend"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sms_cells" />
</androidx.constraintlayout.widget.ConstraintLayout>
