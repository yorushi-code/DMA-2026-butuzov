<?xml version="1.0" encoding="utf-8"?>
<!-- Item 8: name and switch on one row; each slider has its label and live value on the
     row above it; the monthly price at the bottom (recomputed by Behaviors.tariff). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/gap"
    android:background="@drawable/bg_card"
    android:padding="@dimen/gap">

    <TextView
        android:id="@+id/tariff_name"
        style="@style/T5.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/m08_name"
        app:layout_constraintEnd_toStartOf="@id/tariff_switch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/tariff_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:contentDescription="@string/m08_name"
        app:layout_constraintBottom_toBottomOf="@id/tariff_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tariff_name" />

    <TextView
        android:id="@+id/tariff_minutes_label"
        style="@style/T5.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/m08_minutes_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tariff_switch" />

    <TextView
        android:id="@+id/tariff_minutes"
        style="@style/T5.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@id/tariff_minutes_label"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/tariff_minutes_slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/m08_minutes_label"
        android:stepSize="100"
        android:value="500"
        android:valueFrom="100"
        android:valueTo="2000"
        app:labelBehavior="gone"
        app:tickVisible="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tariff_minutes_label" />

    <TextView
        android:id="@+id/tariff_gb_label"
        style="@style/T5.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/m08_gb_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tariff_minutes_slider" />

    <TextView
        android:id="@+id/tariff_gb"
        style="@style/T5.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBaseline_toBaselineOf="@id/tariff_gb_label"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/tariff_gb_slider"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/m08_gb_label"
        android:stepSize="5"
        android:value="20"
        android:valueFrom="5"
        android:valueTo="100"
        app:labelBehavior="gone"
        app:tickVisible="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tariff_gb_label" />

    <TextView
        android:id="@+id/tariff_extra"
        style="@style/T5.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="@string/m08_roaming"
        app:drawableStartCompat="@drawable/ic_check"
        app:drawableTint="@color/ok"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tariff_gb_slider" />

    <TextView
        android:id="@+id/tariff_price"
        style="@style/T5.Headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:textColor="@color/brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tariff_extra" />
</androidx.constraintlayout.widget.ConstraintLayout>
