<?xml version="1.0" encoding="utf-8"?>
<!-- Item 36: the 16:9 video box and its controls share one ConstraintLayout; the controls
     are constrained to the video's edges (pause centre, fullscreen bottom-end, quality
     top-end) and listed in a Group, which Behaviors.videoControls toggles on tap. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/video_surface"
        style="@style/T5.Photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_gradient_video"
        android:contentDescription="@string/m36_title"
        android:importantForAccessibility="yes"
        android:src="@null"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/video_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/scrim_light"
        app:layout_constraintBottom_toBottomOf="@id/video_surface"
        app:layout_constraintEnd_toEndOf="@id/video_surface"
        app:layout_constraintStart_toStartOf="@id/video_surface"
        app:layout_constraintTop_toTopOf="@id/video_surface" />

    <ImageButton
        android:id="@+id/video_pause"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/scrim"
        android:contentDescription="@string/cd_pause"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pause"
        app:layout_constraintBottom_toBottomOf="@id/video_surface"
        app:layout_constraintEnd_toEndOf="@id/video_surface"
        app:layout_constraintStart_toStartOf="@id/video_surface"
        app:layout_constraintTop_toTopOf="@id/video_surface"
        app:tint="@color/on_dark" />

    <TextView
        android:id="@+id/video_quality"
        style="@style/T5.Badge"
        android:layout_margin="12dp"
        android:background="@drawable/bg_rounded"
        android:backgroundTint="@color/scrim"
        android:contentDescription="@string/cd_quality"
        android:text="@string/m36_quality"
        app:layout_constraintEnd_toEndOf="@id/video_surface"
        app:layout_constraintTop_toTopOf="@id/video_surface" />

    <TextView
        android:id="@+id/video_time"
        style="@style/T5.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/m36_time"
        android:textColor="@color/on_dark"
        app:layout_constraintBottom_toBottomOf="@id/video_fullscreen"
        app:layout_constraintStart_toStartOf="@id/video_surface"
        app:layout_constraintTop_toTopOf="@id/video_fullscreen" />

    <ImageButton
        android:id="@+id/video_fullscreen"
        style="@style/T5.IconButton.Light"
        android:contentDescription="@string/cd_fullscreen"
        android:src="@drawable/ic_fullscreen"
        app:layout_constraintBottom_toBottomOf="@id/video_surface"
        app:layout_constraintEnd_toEndOf="@id/video_surface" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/video_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="video_scrim,video_pause,video_quality,video_time,video_fullscreen" />

    <TextView
        android:id="@+id/video_title"
        style="@style/T5.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/gap"
        android:text="@string/m36_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/video_surface" />

    <TextView
        style="@style/T5.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gap"
        android:layout_marginEnd="@dimen/gap"
        android:text="@string/m36_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/video_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
