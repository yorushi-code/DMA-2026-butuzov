<?xml version="1.0" encoding="utf-8"?>
<!-- Item 17: two card sides in one FrameLayout. The back is declared first and pushed
     down and to the end by margins; the front, declared second, overlaps it. The CVC
     field sits on the uncovered strip of the back, at its end edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/gap">

    <FrameLayout
        android:id="@+id/card_sides"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/card_back"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginStart="40dp"
            android:layout_marginTop="80dp"
            android:background="@drawable/bg_gradient_card_back"
            android:gravity="end"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="20dp"
                android:background="@color/media_dark" />

            <TextView
                style="@style/T5.CardLabel"
                android:layout_marginTop="58dp"
                android:text="@string/m17_cvc" />

            <EditText
                android:id="@+id/card_cvc"
                style="@style/T5.CardField"
                android:layout_width="72dp"
                android:layout_marginEnd="@dimen/gap"
                android:hint="@string/m17_cvc"
                android:inputType="numberPassword"
                android:maxLength="3" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_front"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginEnd="40dp"
            android:background="@drawable/bg_gradient_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="@dimen/gap">

            <TextView
                style="@style/T5.CardLabel"
                android:layout_marginEnd="0dp"
                android:text="@string/m17_front" />

            <TextView
                style="@style/T5.CardLabel"
                android:layout_marginTop="@dimen/gap"
                android:layout_marginEnd="0dp"
                android:text="@string/m17_number" />

            <EditText
                android:id="@+id/card_number"
                style="@style/T5.CardField"
                android:layout_width="match_parent"
                android:hint="@string/m17_number_hint"
                android:inputType="number"
                android:maxLength="19" />

            <EditText
                android:id="@+id/card_expiry"
                style="@style/T5.CardField"
                android:layout_width="96dp"
                android:layout_marginTop="@dimen/gap_small"
                android:hint="@string/m17_expiry"
                android:inputType="date"
                android:maxLength="5" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        style="@style/T5.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap_large"
        android:text="@string/m17_note" />

    <Button
        style="@style/T5.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/m17_pay" />
</LinearLayout>
