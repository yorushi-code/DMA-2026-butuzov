<?xml version="1.0" encoding="utf-8"?>
<!-- Item 35: each comment is the same flat ConstraintLayout; a reply only differs in the
     avatar's start margin (16dp + 44dp per level) and a thread line on its left, so the
     tree reads by indentation without nesting comments inside each other. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/gap_small">

        <TextView
            style="@style/T5.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gap"
            android:layout_marginBottom="@dimen/gap_small"
            android:text="@string/m35_title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/comment_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap_small"
            android:paddingEnd="@dimen/gap"
            android:paddingBottom="@dimen/gap_small">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/comment_avatar_1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:background="@color/photo_4"
                android:contentDescription="@string/cd_avatar"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/T5.Shape.Circle"
                app:tint="@color/on_dark" />

            <TextView
                android:id="@+id/comment_user_1"
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/m35_user_1"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/comment_avatar_1"
                app:layout_constraintTop_toTopOf="@id/comment_avatar_1" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:text="@string/m35_time_1"
                app:layout_constraintBaseline_toBaselineOf="@id/comment_user_1"
                app:layout_constraintStart_toEndOf="@id/comment_user_1" />

            <TextView
                android:id="@+id/comment_text_1"
                style="@style/T5.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/m35_text_1"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/comment_user_1"
                app:layout_constraintTop_toBottomOf="@id/comment_user_1" />

            <TextView
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tiny"
                android:text="@string/m35_reply"
                android:textColor="@color/brand"
                app:layout_constraintStart_toStartOf="@id/comment_user_1"
                app:layout_constraintTop_toBottomOf="@id/comment_text_1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/comment_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap_small"
            android:paddingEnd="@dimen/gap"
            android:paddingBottom="@dimen/gap_small">

            <View
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginStart="32dp"
                android:background="@color/outline"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/comment_avatar_2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="60dp"
                android:background="@color/photo_2"
                android:contentDescription="@string/cd_avatar"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/T5.Shape.Circle"
                app:tint="@color/on_dark" />

            <TextView
                android:id="@+id/comment_user_2"
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/m35_user_2"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/comment_avatar_2"
                app:layout_constraintTop_toTopOf="@id/comment_avatar_2" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:text="@string/m35_time_2"
                app:layout_constraintBaseline_toBaselineOf="@id/comment_user_2"
                app:layout_constraintStart_toEndOf="@id/comment_user_2" />

            <TextView
                android:id="@+id/comment_text_2"
                style="@style/T5.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/m35_text_2"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/comment_user_2"
                app:layout_constraintTop_toBottomOf="@id/comment_user_2" />

            <TextView
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tiny"
                android:text="@string/m35_reply"
                android:textColor="@color/brand"
                app:layout_constraintStart_toStartOf="@id/comment_user_2"
                app:layout_constraintTop_toBottomOf="@id/comment_text_2" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/comment_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap_small"
            android:paddingEnd="@dimen/gap"
            android:paddingBottom="@dimen/gap_small">

            <View
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_marginStart="76dp"
                android:background="@color/outline"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/comment_avatar_3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="104dp"
                android:background="@color/photo_4"
                android:contentDescription="@string/cd_avatar"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/T5.Shape.Circle"
                app:tint="@color/on_dark" />

            <TextView
                android:id="@+id/comment_user_3"
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/m35_user_3"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/comment_avatar_3"
                app:layout_constraintTop_toTopOf="@id/comment_avatar_3" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:text="@string/m35_time_3"
                app:layout_constraintBaseline_toBaselineOf="@id/comment_user_3"
                app:layout_constraintStart_toEndOf="@id/comment_user_3" />

            <TextView
                android:id="@+id/comment_text_3"
                style="@style/T5.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/m35_text_3"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/comment_user_3"
                app:layout_constraintTop_toBottomOf="@id/comment_user_3" />

            <TextView
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tiny"
                android:text="@string/m35_reply"
                android:textColor="@color/brand"
                app:layout_constraintStart_toStartOf="@id/comment_user_3"
                app:layout_constraintTop_toBottomOf="@id/comment_text_3" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/comment_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/gap_small"
            android:paddingEnd="@dimen/gap"
            android:paddingBottom="@dimen/gap_small">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/comment_avatar_4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="16dp"
                android:background="@color/photo_5"
                android:contentDescription="@string/cd_avatar"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/T5.Shape.Circle"
                app:tint="@color/on_dark" />

            <TextView
                android:id="@+id/comment_user_4"
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/m35_user_4"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/comment_avatar_4"
                app:layout_constraintTop_toTopOf="@id/comment_avatar_4" />

            <TextView
                style="@style/T5.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_small"
                android:text="@string/m35_time_4"
                app:layout_constraintBaseline_toBaselineOf="@id/comment_user_4"
                app:layout_constraintStart_toEndOf="@id/comment_user_4" />

            <TextView
                android:id="@+id/comment_text_4"
                style="@style/T5.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/m35_text_4"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/comment_user_4"
                app:layout_constraintTop_toBottomOf="@id/comment_user_4" />

            <TextView
                style="@style/T5.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_tiny"
                android:text="@string/m35_reply"
                android:textColor="@color/brand"
                app:layout_constraintStart_toStartOf="@id/comment_user_4"
                app:layout_constraintTop_toBottomOf="@id/comment_text_4" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
