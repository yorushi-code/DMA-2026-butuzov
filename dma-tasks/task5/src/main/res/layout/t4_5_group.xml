<?xml version="1.0" encoding="utf-8"?>
<!-- T4.5: a Group lists three views by id; Behaviors.groupToggle hides and shows them
     with one call on the group. A Group does not nest anything: the layout stays flat. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/gap">

    <TextView
        android:id="@+id/group_note"
        style="@style/T5.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/t4_5_note"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/group_toggle"
        style="@style/T5.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/t4_5_toggle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/group_note" />

    <TextView
        android:id="@+id/group_item_1"
        style="@style/T5.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/gap"
        android:text="@string/t4_5_item_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/group_toggle" />

    <TextView
        android:id="@+id/group_item_2"
        style="@style/T5.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/t4_5_item_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/group_item_1" />

    <ImageView
        android:id="@+id/group_item_3"
        style="@style/T5.Photo"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="@dimen/gap_small"
        android:background="@color/photo_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/group_item_2" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="group_item_1,group_item_2,group_item_3" />
</androidx.constraintlayout.widget.ConstraintLayout>
