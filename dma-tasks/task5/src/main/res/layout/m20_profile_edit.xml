<?xml version="1.0" encoding="utf-8"?>
<!-- Item 20: the round photo and the camera button are two layers of one FrameLayout
     (camera pinned bottom|end); the fields are TextInputLayouts with floating hints. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/gap">

        <FrameLayout
            android:id="@+id/profile_photo_frame"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/gap">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profile_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/photo_3"
                android:contentDescription="@string/cd_avatar"
                android:padding="16dp"
                android:src="@drawable/ic_person"
                app:shapeAppearance="@style/T5.Shape.Circle"
                app:tint="@color/on_dark" />

            <ImageButton
                android:id="@+id/profile_camera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_ring"
                android:contentDescription="@string/cd_camera"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera"
                app:tint="@color/brand" />
        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/T5.Field"
            android:layout_marginTop="@dimen/gap_large"
            android:hint="@string/m20_name">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:text="@string/m20_name_value" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/T5.Field"
            android:layout_marginTop="12dp"
            android:hint="@string/m20_username"
            app:prefixText="\@">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="@string/m20_username_value" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/T5.Field"
            android:layout_marginTop="12dp"
            android:hint="@string/m20_email">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/T5.Field"
            android:layout_marginTop="12dp"
            android:hint="@string/m20_bio"
            app:counterEnabled="true"
            app:counterMaxLength="150">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:text="@string/m20_bio_value" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            style="@style/T5.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/gap_large"
            android:text="@string/m20_save" />
    </LinearLayout>
</ScrollView>
